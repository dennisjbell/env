removehost() {
  ssh-keygen -R $(head -$1 ~/.ssh/known_hosts | tail -1 | awk '{print $1}' | sed -e 's/,.*//')
}

getip() {
  dig +short myip.opendns.com @resolver1.opendns.com.
  echo ""
}

