# -----------------------------------------------------------------------------
# Network aliases and functions
# -----------------------------------------------------------------------------
showcert() {
  echo | \
    openssl s_client -showcerts -servername $1 -connect $1:${2:-443} 2>/dev/null | \
    openssl x509 -inform pem -noout -text
}


# -----------------------------------------------------------------------------
# colorize
# -----------------------------------------------------------------------------
color() {
  local colors=" k=0 r=1 g=2 y=3 b=4 m=5 p=5 c=6 w=7 "
  local ansi="" c="$(echo "$2" | tr "[:upper:]" "[:lower:]")"
  local fg="${c:0:1}" bg="${c:1:1}"
  if [[ -n "${fg}" ]] ; then
    ansi="3$(echo "$colors" | sed "s/.* ${fg}=\\([^ ]*\\) .*/\\1/")"
    [[ "${#ansi}" -eq 2 ]] || ansi=""
    [[ "${fg}" == "${2:0:1}" || -z "$ansi" ]] || ansi="1;${ansi}"
  fi
  if [[ -n "${bg}" ]] ; then
    local bg_ansi="4$(echo "$colors" | sed "s/.* ${bg}=\\([^ ]*\\) .*/\\1/")"
    [[ "${#bg_ansi}" -eq 2 ]] && ansi="${ansi:+$ansi;}$bg_ansi"
  fi
  printf "\x1b[${ansi}m%b\x1b[0m" "$1"
}

rainbow() {
  colors="rRyYGCbp"; ci=-1
  si=0;
  out=""
  local str="$(printf "%b" "$1.")"
  str="${str:0:${#str}-1}" # preserve trailing newlines
  while [[ $si -lt "${#str}" ]] ; do
    ch="${str:$si:1}"
    if [[ "$ch" =~ ^[[:print:]]$ ]] ; then
      let 'ci++'
      out="${out}$(color "$ch" ${colors:$((ci % 8 )):1}$2)"
    else
      out="$out$ch"
    fi
    let "si++"
  done
  printf "%b" "$out"
}

contains() {
  # returns 0 if present, 1 if not; outputs index where element found
  # NOTE: index is 1-based, to support $@;
  local el=$1; shift
  local re_mode=false
  if [[ "$el" =~ ^/.*/$ ]] ; then
    re_mode=true
    el="${el:1:${#el}-2}"
  fi
  local i=1
  while (( $# > 0 )) ; do
    local found=false
    if $re_mode ; then
      [[ "$1" =~ $el ]] && found=true
    else
      [[ "$1" == "$el" ]] && found=true
    fi
    if $found ; then
      echo $i;
      return 0
    fi
    shift
    (( ++i ))
  done
  return 1
}

alias ppry="perl -Ilib -MPry -e 'pry;'"

Files() {
  diff "$1" "$3"
}

sincelast() {
  no_spec=( '.' )
  summary_opt=''
  color=always
  echo "Options ($#):" "$@"
  while (( $# > 0 )) ; do
    case "$1" in
      -x|--no-spec-results)
        echo >&2 "Excluding any changes to spec/results..."
        no_spec=( "--" "." ':!spec/results' )
        ;;
      -s|--summary)
        echo >&2 "Only showing files that changes (not changes themselves)"
        summary_opt='--name-only'
        ;;
      -n|--no-color)
        color='never'
        ;;
      *)
        echo >&2 "Unknown option $1: Expected -x|--no-spec-results, -s|--summary"
        return 1
        ;;
    esac
    shift
  done

  last_release="$(git hist | grep 'tag: v[0-9\.]*\(,[^)].*\)\?)'|head -n 1 | sed -e 's/.*\([0-9a-f]\{7\}\) - (tag.*/\1/')"
  git -c color.ui="$color" log -p --reverse $summary_opt "${last_release}..." "${no_spec[@]}"
}

gci_cmp() {
  local subpath="${1:-.}"
  local sample="${2:-vault}"
  if [[ ! -d "$sample-genesis-kit" ]] ; then
    echo "[31;1mNo $sample-genesis-kit directory found[0m"
    return 1
  fi
  for x in *-genesis-kit; do
    if [[ "$x" == "$sample-genesis-kit" ]] ; then
      continue
    fi
    echo "[33;1m$x[0m"
    if [[ ! -f "$x/ci/$subpath" ]] ; then
      echo "[31;1mNo $subpath in $x[0m"$'\n'
      continue
    fi
    diff "$sample-genesis-kit/ci/$subpath" "$x/ci/$subpath"
    if [[ "$?" -eq 0 ]] ; then
      echo "[32;1mNo differences[0m"$'\n'
    else
      read -p "[33;1mReplace $x/ci/$subpath with $sample-genesis-kit/ci/$subpath? [yNqm][0m " -n 1 -r answer
      echo

      if [[ "$answer" == "y" ]] ; then
        cp "$sample-genesis-kit/ci/$subpath" "$x/ci/$subpath"
      fi
      if [[ "$answer" == "q" ]] ; then
        return 0
      fi
      if [[ "$answer" == "m" ]] ; then
        mvim -g -f -d "$sample-genesis-kit/ci/$subpath" "$x/ci/$subpath"
      fi
    fi
  done
}

# checkssl <host[:port] | url> [servername]
# Print the leaf cert's subject, SANs, issuer, and validity window
checkssl() {
    local input="${1:?usage: checkssl <host[:port] | url> [servername]}"
    input="${input#*://}"        # strip https:// or http:// if pasted
    input="${input%%/*}"         # strip any /path
    local host="${input%:*}"
    local port="${input##*:}"
    [[ "$port" == "$input" ]] && port=443
    local sni="${2:-$host}"

    openssl s_client -connect "$host:$port" -servername "$sni" </dev/null 2>/dev/null \
        | openssl x509 -noout -subject -issuer -dates -ext subjectAltName
}

# checkssl-expires <host[:port] | url> [servername]
# Same as checkssl, plus a one-line "Expires in N days"
checkssl-expires() {
    local end
    end=$(checkssl "$@" | awk -F= '/notAfter=/ {print $2}')
    [[ -z "$end" ]] && { echo >&2 "checkssl-expires: no cert returned"; return 1; }
    printf '%s\nExpires in %d days\n' "$end" \
        "$(( ($(date -j -f '%b %d %T %Y %Z' "$end" +%s) - $(date +%s)) / 86400 ))"
}

# =============================================================================
# uv-managed Python
# -----------------------------------------------------------------------------
# uv installs versioned executables (python3.13, ...) here. Prepended so they
# win over brew's python@3.x of the same minor -- brew's copies exist to serve
# other formulae, not for development.
#
# This is only safe while uv is installed WITHOUT --default: uv then creates
# versioned names only, so bare `python3` still falls through to brew. Adding
# --default would claim `python`/`python3` here and shadow it.
if [ -d "$HOME/.local/bin" ] ; then
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi

# =============================================================================
# Completions
# -----------------------------------------------------------------------------
# Sourced from the env repo's completions/ dir, linked to ~/.completions by
# setup.sh. Drop a new *.bash in there and it gets picked up automatically.
_comp_dir="$DJBELL_BASE/.completions"
if [ -d "$_comp_dir" ] ; then
  for _comp in "$_comp_dir"/*.bash ; do
    [ -f "$_comp" ] || continue
    case "${_comp##*/}" in
      # Defer to the OS/brew bash-completion package if it already supplied
      # git's completion -- theirs tracks the installed git version.
      git-completion.bash)
        type -t __git_complete >/dev/null 2>&1 && continue ;;
      # Pointless without the binary, and it shells out to it on every tab.
      fly_completion.bash)
        command -v fly >/dev/null 2>&1 || continue ;;
    esac
    . "$_comp"
  done
  unset _comp
fi
unset _comp_dir
